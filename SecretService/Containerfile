FROM golang:1.26 AS build
WORKDIR /src
COPY SecretService/go.mod SecretService/go.sum ./
RUN go mod download
COPY SecretService/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /secretservice ./cmd/secretservice

FROM gcr.io/distroless/static:nonroot
COPY --from=build /secretservice /secretservice
EXPOSE 8443
ENTRYPOINT ["/secretservice"]
