VERSION=0.0.1-DEV
FILESERVER_PASSWORD=replace-with-a-distinct-random-service-secret-at-least-32-characters
SECRET_ADMIN_SECRET=replace-with-a-distinct-random-service-secret-at-least-32-characters
SECRET_SERVICE_SECRET=replace-with-a-distinct-random-service-secret-at-least-32-characters
# Certificate must include DNS:secretservice and the client-facing hostname or IP.
SECRET_TLS_CERT=/home/jack/.cert/secretservice.crt
SECRET_TLS_KEY=/home/jack/.ssh/secretservice
SECRET_SERVICE_CA=/home/jack/.cert/ca.crt
SECRET_SERVICE_DATA=./data/secretservice-data
# Comma-separated trusted frontend origins if browser clients call SecretService.
SECRET_ALLOWED_ORIGINS=