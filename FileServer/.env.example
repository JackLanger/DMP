VERSION=0.0.1-SNAPSHOT
SECRET_ADMIN_SECRET=replace-with-a-distinct-random-admin-secret-at-least-32-characters
SECRET_SERVICE_CREDENTIAL=replace-with-a-distinct-random-service-secret-at-least-32-characters
# Comma-separated trusted frontend origins if browser clients call SecretService.
SECRET_ALLOWED_ORIGINS=
FILESERVER_MULTIPART_MAX_DISK_USAGE_PER_PART=100MB
FILE_SERVER_DATA=
# Required only with compose.https.yaml: the Pi's IP address or local hostname.
FILESERVER_HTTPS_HOST=