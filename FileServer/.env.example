VERSION=0.0.1-SNAPSHOT
SECRET_ADMIN_SECRET=replace-with-a-distinct-random-admin-secret-at-least-32-characters
SECRET_SERVICE_CREDENTIAL=replace-with-a-distinct-random-service-secret-at-least-32-characters
SECRET_TLS_CERT=/absolute/path/to/secretservice.crt
SECRET_TLS_KEY=/absolute/path/to/secretservice.key
SECRET_SERVICE_CA=/absolute/path/to/ca.crt
SECRET_SERVICE_DATA=/absolute/path/to/secretservice-data
# Optional image tags for published containers; both default to latest.
# FILESERVER_IMAGE_TAG=latest
# SECRETSERVICE_IMAGE_TAG=latest
# Comma-separated trusted browser origins for account and file requests.
SECRET_ALLOWED_ORIGINS=http://localhost:1420,http://tauri.localhost,https://tauri.localhost,tauri://localhost
FILESERVER_MULTIPART_MAX_DISK_USAGE_PER_PART=100MB
FILE_SERVER_DATA=
# Required only with compose.https.yaml: the Pi's IP address or local hostname.
FILESERVER_HTTPS_HOST=