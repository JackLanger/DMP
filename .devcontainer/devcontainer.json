{
  "name": "DMP",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.26.10"
    },
    "ghcr.io/devcontainers/features/java:1": {
      "version": "26",
      "jdkDistro": "tem"
    }
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/dmp,type=bind",
  "workspaceFolder": "/workspaces/dmp",
  "remoteUser": "node",
  "postCreateCommand": "npm ci --prefix portal",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "vscjava.vscode-java-debug",
        "vscjava.vscode-java-pack",
        "rust-lang.rust-analyzer",
        "tauri-apps.tauri-vscode"
      ]
    }
  }
}
