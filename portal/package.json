{
  "name": "portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "electron .",
    "dev:desktop": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build:desktop": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.portal.desktop",
    "productName": "Portal",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.4.1",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  }
}
